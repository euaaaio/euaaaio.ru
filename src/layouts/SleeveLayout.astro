---
import '@/styles/index.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- The sheet is drawn at a fixed width and zoomed to fit by scripts/fit. -->
    <meta name="viewport" content="width=2056" />

    <link href="/favicon.ico" rel="icon" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/manifest.webmanifest" rel="manifest" />
    <link href="/sitemap-index.xml" rel="sitemap" />
    <meta name="theme-color" content="#d8d8d4" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script>
      import { init } from '@plausible-analytics/tracker'

      init({
        domain: 'euaaaio.ru',
        endpoint: 'https://plausible.aoiestudio.ru/api/event',
      })
    </script>
  </head>
  <body>
    <slot />

    <script>
      import '@/scripts/fit'
      import '@/scripts/proximity'
    </script>
  </body>
</html>
