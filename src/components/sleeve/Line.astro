---
import type { Line } from '@/types/sleeve'

interface Props {
  line: Line
}

const { line } = Astro.props

const { text, crush, strike, href } =
  typeof line === 'string'
    ? { text: line, crush: undefined, strike: false, href: undefined }
    : line

const isExternal = href !== undefined && href.startsWith('http')
---

<div
  class:list={[
    'line',
    crush === 1 && 'k1',
    crush === 2 && 'k2',
    strike && 'strike',
  ]}
>
  {
    href ? (
      <a
        href={href}
        rel={isExternal ? 'noopener' : undefined}
        target={isExternal ? '_blank' : undefined}
      >
        {text}
      </a>
    ) : (
      text
    )
  }
</div>
